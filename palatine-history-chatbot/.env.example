# Copy this file to ".env" and fill in what you need.

# Which AI backend powers answers and photo transcription:
#   gemini  (FREE tier) | claude | openai | local
# Leave the matching key blank to run 100% free "search-only" mode.
AI_PROVIDER=gemini

# --- Google Gemini (AI_PROVIDER=gemini) — FREE, no credit card ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Claude (AI_PROVIDER=claude) — paid ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- OpenAI (AI_PROVIDER=openai) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Local / offline (AI_PROVIDER=local) ---
# LOCAL_MODEL=llama3.2
# LOCAL_BASE_URL=http://localhost:11434

# --- Web app ---
HOST=127.0.0.1
PORT=5000

# --- Retrieval tuning (optional) ---
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# TOP_K=6

# --- Scraper (optional) ---
# HISTORICAL_SOCIETY_URL=https://palatinehistoricalsociety.com
# SCRAPER_DELAY_SECONDS=1.0
# SCRAPER_MAX_PAGES=300
